# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="DiagnostiCare Advanced Diagnostic Center"

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/diagnostic_center_db

# Cache & Background Worker (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
AUTH_SECRET=development_super_secret_diagnostic_center_key_2026_auth
AUTH_COOKIE_NAME=dcms_auth_token

# Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# External Notifications
EMAIL_PROVIDER_KEY=your_email_api_key
SMS_PROVIDER_KEY=your_sms_gateway_api_key
